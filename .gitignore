# ---- third-party binaries (download + verify separately, see docs/data_sources.md)
tools/vina.exe
tools/*.exe

# ---- raw downloads: fetched from public endpoints, hashes recorded in
#      data/raw/manifest.json and results/docking/manifest.json
#      (note: `data/raw/` would exclude the directory outright and make the
#       re-include below a no-op -- git cannot re-include a file whose parent
#       directory is ignored, so the contents are excluded one level deeper)
data/raw/*
!data/raw/manifest.json

# ---- large derived arrays (regenerated by scripts/01_features.py)
data/processed/features/ligand_tanimoto.npy

# ---- per-run prediction dumps (regenerated by scripts/03_models.py; needed by 04/06)
results/predictions/
# ---- the same for the external table (regenerated by 14_external_chembl.py --stage grid;
#      the committed metrics.csv / paired_bootstrap.json carry every reported number)
results/external_chembl/predictions/
# ---- per-cell interval arrays (regenerated by scripts/04_uncertainty.py; the
#      committed conformal.csv / coverage_curve.csv carry every reported number)
results/uncertainty/intervals/
# ---- the --quick smoke-test table (a subset run on subsampled rows; every
#      number in README / 一页结论 comes from results/metrics.csv, never this one)
results/metrics_quick.csv

# ---- scratch / logs
_probe/
results/_quick.log
results/_ci_bench.txt
results/ci_bench.txt
results/_selftest_check.txt
results/_invariance.txt
results/_prefix_run_03.log
*.bak

# ---- python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
